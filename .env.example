# Variáveis de ambiente do site. Copie para `.env` (ignorado pelo git) e preencha o que precisar.
# Nunca ponha segredo numa variável com prefixo VITE_: ela vai para o JavaScript público.
# Em produção, defina as variáveis no painel da Netlify, não neste arquivo.

# --- Formulário de contato (EmailJS) ---
# Os três IDs são públicos por natureza do SDK do navegador.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Espaço cultural (/pessoal): docs/specs/personal/README.md, seção 5 ---

# Origem dos dados no navegador: "mock" (dados fictícios, só para a Fase 1) ou "live" (APIs reais).
# O build de produção da Netlify recusa "mock" (scripts/personalGuard.ts).
VITE_PERSONAL_SOURCE=mock

# As variáveis abaixo são só do servidor (Netlify Functions). Segredo fica VAZIO aqui.

# Token pessoal da API do Hardcover (envio como Bearer). Segredo: gere na conta e renove se expirar.
HARDCOVER_API_TOKEN=
# Usuário cujas estantes o Hardcover devolve (público).
HARDCOVER_USERNAME=dudapbrt

# Chave da API do TMDB (pôsteres e metadados de filmes). Segredo: gere em themoviedb.org/settings/api.
TMDB_API_KEY=

# Usuário do feed RSS público do Letterboxd: https://letterboxd.com/<usuário>/rss/ (não é segredo).
LETTERBOXD_USERNAME=dudapbrt

# Validade do cache dos livros, em minutos, antes de buscar de novo no Hardcover (decisão D9: 6 h).
PERSONAL_HARDCOVER_TTL_MIN=360
# Validade do cache do diário de filmes, em minutos, antes de reler o RSS (decisão D9: 1 h).
PERSONAL_LETTERBOXD_TTL_MIN=60

# Segredo do endpoint de atualização manual ou de webhook. Segredo.
PERSONAL_REFRESH_SECRET=
# URL do build hook da Netlify que a função agendada aciona para regerar o HTML estático. Segredo.
PERSONAL_BUILD_HOOK_URL=

